grammar Hanno;

program         : block ;
expr            : adt
                | definition
                | annotation
                | func
                | pair
                | with
                | cond
                | match
                | and
                | or
                | not
                | compare
                | equality
                | add_sub_join
                | mod_div_mul
                | exponent
                | negate
                | apply
                ;

adt             : "type" variant
                | "type" type "=" variant { "|" variant }
                ;
definition      : "let" pattern ( "=" expr | ":=" block "end" ) ;
annotation      : NAME "::" type ;
func            : "\" pattern "->" expr ;
match           : "match" expr { "|" pattern "->" expr } ;
cond            : "if" expr "then" expr "else" expr ;
pair            : expr "," expr ;
with            : expr "with" NAME "=" expr { "|" NAME "=" expr } ;
and             : expr "and" expr ;
or              : expr "or" expr ;
not             : "not" expr ;
compare         : expr ( ">" | "<" | ">=" | "<=" ) expr ;
equality        : expr ( "=" | "/=" ) expr ;
add_sub_join    : expr ( "+" | "-" | "<>" ) expr ;
mod_div_mul     : expr ( "*" | "/" | "%" ) expr ;
exponent        : expr { "^" expr } ;
negate          : "-" expr ;
apply           : factor { factor } ;

factor          : list
                | group
                | scalar
                | NAME
                ;
list            : "[" [ expr { "," expr } [ "," ] ] "]" ;
group           : "(" [ expr ] ")" ;
scalar          : bool
                | FLOAT
                | INTEGER
                | STRING
                | TYPE_NAME
                ;
bool            : "True"
                | "False"
                ;

block           : { expr EOL } ;

variant         : type [ "(" [ adt_field { "," adt_field } [ "," ] ] ")" ] ;
adt_field       : NAME "::" type ;

pattern         : "(" [ pattern { "," pattern } [ "," ] ] ")"
                | "[" [ pattern { "," pattern } [ "," ".." NAME ] ] "]"
                | "^" NAME
                | TYPE_NAME [ pattern ]
                | NAME
                | scalar
                ;

type            : "(" [ type ] ")"
                | type "," type
                | type "->" type
                | TYPE_NAME [ type ]
                | NAME
                ;
